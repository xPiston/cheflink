{
  "name": "cheflink",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "wrangler dev --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:compile": "node --experimental-strip-types scripts/i18n-compile.ts",
    "typecheck": "npm run i18n:compile && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply cheflink --local",
    "db:migrate:remote": "wrangler d1 migrations apply cheflink --remote",
    "db:seed": "node --experimental-strip-types scripts/seed.ts && wrangler d1 execute cheflink --local --file scripts/seed.generated.sql",
    "db:seed:remote": "node --experimental-strip-types scripts/seed.ts && wrangler d1 execute cheflink --remote --file scripts/seed.generated.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@inlang/paraglide-js": "^2.25.4",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
